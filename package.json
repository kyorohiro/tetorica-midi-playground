{
  "name": "tetorica-midi-playground",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test test/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "tauri icon assets/app-icon.png",
    "tauri": "tauri",
    "clock:send": "cargo run --manifest-path src-tauri/Cargo.toml --example clock_sender --",
    "clock:test": "cargo test --manifest-path src-tauri/Cargo.toml --example clock_sender"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "acorn": "^8.18.0",
    "es-module-lexer": "^3.0.2",
    "monaco-editor": "^0.52.2"
  },
  "type": "module"
}
